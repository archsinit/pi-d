{
  "name": "pi-d-chat",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "archsinit <admin@archsinit.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archsinit/pi-d.git"
  },
  "type": "module",
  "description": "A btop-inspired coding terminal for the stock pi-durable Harness",
  "bin": {
    "pi-d": "bin/pi-d.mjs"
  },
  "exports": {
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "import": "./dist/extensions.js"
    }
  },
  "files": [
    "bin/", "dist/", "docs/comparison.md", "docs/extensions.md", "docs/usage.md", "docs/preview.svg", "licenses/", "LICENSE", "NOTICE", "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "demo": "node --disable-warning=ExperimentalWarning src/cli.ts --demo",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "preview": "node --disable-warning=ExperimentalWarning scripts/preview.ts",
    "smoke": "python3 scripts/terminal-smoke.py"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "22.19.19",
    "jiti": "2.7.0",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/proper-lockfile": "4.1.4",
    "@xterm/headless": "5.5.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "protobufjs": "7.6.6"
  }
}
